# Release signing for the portal Android app — TEMPLATE.
#
# Copy to `keystore.properties` (gitignored) or supply these as environment
# variables in CI. NEVER commit the real file or the keystore itself.
#
# Whoever holds this key is the only one who can ship an update to installed
# apps. Back it up somewhere other than the machine that builds (see
# portal/ANDROID.md, "Keystore custody").

# Absolute path to your release keystore (keep it outside this repo)
PORTAL_KEYSTORE_PATH=/secure/path/to/portal-release.jks
PORTAL_KEYSTORE_PASSWORD=
PORTAL_KEY_ALIAS=portal
PORTAL_KEY_PASSWORD=
