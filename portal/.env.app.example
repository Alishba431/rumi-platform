# Android portal app — build config. Copy to `.env.app` (gitignored) and fill in.
# Read by `npm run build:app` (Vite), capacitor.config.ts and android/app/build.gradle.
# Environment variables with the same names win over this file (CI uses that).
# Full walkthrough: portal/ANDROID.md

# Required by Vite to build the app bundle (do not change).
VITE_APP_TARGET=app

# Absolute https url of your portal's API. The app refuses to build without one.
VITE_API_BASE_URL=https://portal.example.org/api/portal

# Android package id. Choose it ONCE: a store identifies the app by it forever.
# Release builds refuse the org.example.* placeholder.
PORTAL_APP_ID=org.example.rumi.portal

# Launcher label (debug builds append " Debug").
PORTAL_APP_NAME=Rumi Portal

# 1 = load the portal from the live server on launch, so a web deploy updates
# every installed app (over-the-air). 0 = use the copy bundled in the APK.
PORTAL_APP_OTA=0
